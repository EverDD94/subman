<?xml version="1.0" encoding="utf-8"?>
<component name="ListPoster" extends="Group">
  <children>
    <Rectangle id="backdrop" />
    <ScrollingText id="Series" horizAlign="center" repeatCount="0" visible="false"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="33" /></ScrollingText>
    <Poster id="poster" translation="[2,0]" loadDisplayMode="scaleToFit">
      <PlayedCheckmark id="playedIndicator" translation="[135, 0]" />
    </Poster>
    <ScrollingText id="title" horizAlign="center" repeatCount="0" visible="false"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="33" /></ScrollingText>
    <Text id="staticTitle" horizAlign="center" wrap="false"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="33" /></Text>
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="itemWidth" type="integer" />
    <field id="itemHasFocus" type="boolean" onChange="focusChanged" />
  </interface>
</component>