<?xml version="1.0" encoding="utf-8"?>
<component name="PlayedCheckmark" extends="Rectangle">
  <children>
    <Label
      id="checkmark"
      width="60"
      height="50"
     
      horizAlign="center"
      vertAlign="center"
      text="✓"
      visible="false"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="36" /></Label>

    <Label
      id="unplayedNumber"
      width="60"
      height="50"
     
      horizAlign="center"
      vertAlign="center"
      visible="false"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="36" /></Label>
  </children>
  <interface>
    <field id="data" type="assocarray" onChange="onDataChange" />
  </interface>
</component>