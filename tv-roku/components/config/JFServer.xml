<?xml version="1.0" encoding="utf-8"?>
<component name="JFServer" extends="Group">

  <interface>
    <field id="itemContent" type="node" onchange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onchange="onItemHasFocusChange" />
  </interface>

  <children>
    <Rectangle id="background" translation="[0,0]" width="1460" height="100" />

    <Poster id="poster" translation="[20,5]" width="90" height="90" />
    <Group id="labels" translation="[120,0]">
      <Text text="Name:" horizAlign="left" width="130" height="65" translation="[0,5]"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="36" /></Text>
      <Text text="URL:" horizAlign="left" width="130" height="65" translation="[0,55]"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="36" /></Text>

      <Text id="name" horizAlign="left" height="65" translation="[145,5]"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="36" /></Text>
      <Text id="baseUrl" horizAlign="left" height="65" translation="[145,55]"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="36" /></Text>
    </Group>

    <Rectangle id="trashContainer" translation="[1480,0]" width="100" height="100">
      <Poster id="trash" width="50" height="50" uri="pkg:/images/icons/trash.png" translation="[25,25]" />
    </Rectangle>
  </children>

</component>