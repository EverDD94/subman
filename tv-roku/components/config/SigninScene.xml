<?xml version="1.0" encoding="utf-8"?>
<component name="SigninScene" extends="JFScreen">
  <children>
    <!-- Everflix look: soft blue glow behind a centred card, pills for the buttons -->
    <Poster uri="pkg:/images/everflix/intro-end.jpg" width="1920" height="1080" opacity="0.18" loadDisplayMode="scaleToZoom" />
    <Poster uri="pkg:/images/everflix/shade-bottom.png" width="1920" height="1080" />
    <Poster uri="pkg:/images/everflix/logo-full.png" width="264" height="80" translation="[828, 56]" />
    <Text text="Inicia sesión" horizAlign="center" width="1920" translation="[0, 166]" color="0xF4F2EEFF"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="54" /></Text>
    <Text text="Escribe tu usuario y contraseña para entrar" horizAlign="center" width="1920" translation="[0, 238]" color="0x9AA0ADFF"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="28" /></Text>

    <Poster uri="pkg:/images/everflix/mask-circle.png" width="166" height="166" translation="[877, 292]" blendColor="0x3D63E0FF" />
    <MaskGroup maskUri="pkg:/images/everflix/mask-circle.png" maskSize="[156, 156]" translation="[882, 297]">
      <Poster id="overlayCurrentUserProfileImage" uri="pkg:/images/baseline_person_white_48dp.png" width="156" height="156" loadDisplayMode="scaleToZoom" />
    </MaskGroup>

    <Rectangle id="errorContainer" visible="false" width="800" height="56" translation="[560, 470]">
      <Text id="errorMessage" text="" wrap="true" width="780" horizAlign="center" translation="[10, 12]"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="28" /></Text>
    </Rectangle>

    <Poster id="signInFormContainer" uri="pkg:/images/everflix/round8.9.png" blendColor="0x161A22FF" width="840" height="230" translation="[540, 540]" />
    <FormList id="configOptions" translation="[585, 568]" itemSpacing="[0, 25]" />

    <CheckList
      id="saveCredentials"
      checkedState="[true]"
      translation="[585, 800]"
      focusFootprintBitmapUri=""
      drawFocusFeedback="false">
      <ContentNode role="content">
        <ContentNode title="Recordar mis datos" />
      </ContentNode>
    </CheckList>

    <StandardButton id="submit" text="Entrar" height="84" width="400" translation="[540, 900]" />
    <StandardButton id="quickConnect" text="Conexión rápida" height="84" width="400" translation="[980, 900]" />

    <Timer id="quickConnectTimer" duration="3" repeat="true" />
  </children>
  <interface>
    <field id="user" type="string" onchange="onUserChange" value="" />
    <field id="profileImageUri" type="string" onchange="onProfileImageUriChange" value="" alwaysNotify="true" />
    <field id="alert" type="string" onchange="onAlertChange" value="" />
  </interface>
</component>