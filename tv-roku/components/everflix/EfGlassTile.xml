<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix: glass card button (icon over a short name). The primary one is wide and white. -->
<component name="EfGlassTile" extends="Group">
  <children>
    <Group id="body">
      <Poster id="ring" uri="pkg:/images/everflix/ring20.9.png" visible="false" />
      <Poster id="bg" uri="pkg:/images/everflix/round20.9.png" />
      <Poster id="icon" width="40" height="40" />
      <Label id="label" />
    </Group>
    <Animation id="grow" duration="0.18" easeFunction="outCubic">
      <Vector2DFieldInterpolator id="growI" key="[0.0, 1.0]" fieldToInterp="body.scale" />
    </Animation>
  </children>
  <interface>
    <field id="text" type="string" onChange="paint" />
    <field id="icon" type="string" onChange="paint" />
    <field id="primary" type="boolean" value="false" onChange="paint" />
    <field id="selected" type="boolean" value="false" onChange="paint" />
    <field id="highlighted" type="boolean" value="false" onChange="onHighlight" />
    <field id="small" type="boolean" value="false" />
    <field id="trail" type="string" />
    <field id="key" type="string" />
    <field id="pillWidth" type="float" />
  </interface>
</component>
