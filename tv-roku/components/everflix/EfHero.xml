<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix: the big title block over the backdrop (same as HomeHero on Google TV). -->
<component name="EfHero" extends="Group">
  <children>
    <LayoutGroup id="column" layoutDirection="vert" itemSpacings="[14]">
      <Group id="previewTag" visible="false">
        <Poster id="previewBg" uri="pkg:/images/everflix/pill.9.png" blendColor="0x0000008C" width="130" height="34" />
        <Label id="previewLabel" text="Avance" width="130" height="34" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
      </Group>
      <LayoutGroup id="badgeRow" layoutDirection="horiz" itemSpacings="[18]" vertAlignment="center">
        <Group id="badge">
          <Poster id="badgeBg" uri="pkg:/images/everflix/round8.9.png" blendColor="0x3D63E0FF" height="32" />
          <Label id="badgeLabel" height="32" vertAlign="center" color="0xFFFFFFFF" translation="[12, 0]" />
        </Group>
        <Label id="meta" color="0xF4F2EECC" />
      </LayoutGroup>
      <Label id="title" width="1000" wrap="true" maxLines="2" lineSpacing="-6" color="0xF4F2EEFF" />
      <LayoutGroup id="episodeRow" layoutDirection="horiz" itemSpacings="[26]">
        <Label id="episode" color="0x9DB4FFFF" />
        <Label id="left" color="0xF4F2EEB3" />
      </LayoutGroup>
      <Group id="bar" visible="false">
        <Rectangle width="340" height="6" color="0xFFFFFF40" />
        <Rectangle id="barFill" width="0" height="6" color="0x3D63E0FF" />
      </Group>
      <Label id="overview" width="1000" wrap="true" maxLines="3" lineSpacing="4" color="0xF4F2EECC" />
    </LayoutGroup>
  </children>
  <interface>
    <field id="item" type="assocarray" onChange="onItem" />
    <field id="preview" type="boolean" value="false" onChange="onPreview" />
    <field id="overviewLines" type="integer" value="3" onChange="onLines" />
    <field id="textWidth" type="integer" value="1000" onChange="onWidth" />
  </interface>
</component>
