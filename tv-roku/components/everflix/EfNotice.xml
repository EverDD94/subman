<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix: el cartel de arriba con los mensajes que mandas desde Videotecario (igual que en la web y Google TV). -->
<component name="EfNotice" extends="Group">
  <children>
    <Group id="box" translation="[460, 56]" opacity="0">
      <Poster id="bg" uri="pkg:/images/everflix/round20.9.png" blendColor="0x12151CEE" width="1000" height="150" />
      <Label id="header" translation="[40, 28]" width="920" color="0xF4F2EEFF" />
      <Label id="text" translation="[40, 74]" width="920" wrap="true" maxLines="2" color="0xD6DAE3FF" />
    </Group>
    <Animation id="fadeIn" duration="0.25" easeFunction="outQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="box.opacity" />
    </Animation>
    <Animation id="fadeOut" duration="0.4" easeFunction="inQuad">
      <FloatFieldInterpolator key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="box.opacity" />
    </Animation>
    <Timer id="hide" duration="12" />
  </children>
  <interface>
    <field id="message" type="assocarray" onChange="onMessage" />
  </interface>
</component>
