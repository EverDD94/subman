<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix: replaces the old Jellyfin radio dialog (audio, subtitles, speed, sort...). Side panel; OK picks, back closes. -->
<component name="EfPicker" extends="Group">
  <children>
    <EfDropdown id="dd" />
  </children>
  <interface>
    <!-- { data: [ { track: { description }, selected, ... } ] } exactly like RadioDialog -->
    <field id="contentData" type="assocarray" />
    <field id="title" type="string" />
    <field id="buttons" type="array" />
    <field id="dialogId" type="string" />
    <!-- { kind: "item", data } or { kind: "button", index } or { kind: "closed" } -->
    <field id="result" type="assocarray" alwaysNotify="true" />
    <function name="open" />
  </interface>
</component>
