<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix: 2:3 poster card for libraries, collections and search. -->
<component name="EfPosterCard" extends="Group">
  <children>
    <Poster id="bg" width="220" height="330" uri="pkg:/images/everflix/round8.9.png" blendColor="0x161A22FF" />
    <MaskGroup id="mask" maskUri="pkg:/images/everflix/mask-poster.png" maskSize="[220, 330]">
      <Poster id="image" width="220" height="330" loadDisplayMode="scaleToZoom" loadWidth="220" loadHeight="330" />
    </MaskGroup>
    <Label id="fallback" width="200" height="330" translation="[10, 0]" vertAlign="center" horizAlign="center" wrap="true" maxLines="3" color="0xF4F2EEFF" />
    <Rectangle id="progressBg" translation="[12, 314]" width="196" height="5" color="0xFFFFFF40" visible="false" />
    <Rectangle id="progress" translation="[12, 314]" width="0" height="5" color="0x3D63E0FF" visible="false" />
    <Poster id="ring" uri="pkg:/images/everflix/focus-ring.9.png" width="220" height="330" visible="false" />
    <Poster id="watched" uri="pkg:/images/icons/check_white.png" width="32" height="32" translation="[178, 10]" visible="false" />
    <Label id="title" translation="[2, 340]" width="216" height="30" color="0xF4F2EEFF" opacity="0.75" />
    <Label id="subtitle" translation="[2, 370]" width="216" height="26" color="0x9AA0ADFF" />
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="rowFocusPercent" type="float" onChange="onFocus" />
    <field id="itemHasFocus" type="boolean" onChange="onFocus" />
  </interface>
</component>
