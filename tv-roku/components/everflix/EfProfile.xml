<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix: "Mi perfil", your photo and name. The photo is picked from the faces of what you watch. -->
<component name="EfProfile" extends="JFScreen">
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0D12FF" />
    <Poster uri="pkg:/images/everflix/mask-circle.png" blendColor="0x3D63E0FF" width="200" height="200" translation="[164, 54]" />
    <Poster uri="pkg:/images/everflix/mask-circle.png" blendColor="0x161A22FF" width="188" height="188" translation="[170, 60]" />
    <Label id="initial" width="188" height="188" translation="[170, 60]" horizAlign="center" vertAlign="center" color="0xF4F2EEFF" />
    <MaskGroup maskUri="pkg:/images/everflix/mask-circle.png" maskSize="[188, 188]" translation="[170, 60]">
      <Poster id="photo" width="188" height="188" loadDisplayMode="scaleToZoom" loadWidth="188" loadHeight="188" />
    </MaskGroup>
    <Label id="name" translation="[410, 74]" width="1300" color="0xF4F2EEFF" />
    <EfPillRow id="actions" translation="[410, 160]" small="true" />
    <Label id="heading" translation="[170, 300]" text="ELIGE TU FOTO" color="0xF4F2EEFF" />
    <Label id="message" translation="[170, 344]" width="1600" color="0x9AA0ADFF" text="Caras de lo que ves. La que elijas sale en Everflix y en la web de Jellyfin." />
    <Label id="empty" translation="[170, 420]" width="1600" color="0x9AA0ADFF" text="Cargando…" />
    <MarkupGrid
      id="grid"
      translation="[170, 410]"
      itemComponentName="EfTile"
      numColumns="7"
      numRows="2"
      itemSize="[220, 320]"
      itemSpacing="[20, 10]"
      vertFocusAnimationStyle="floatingFocus"
      drawFocusFeedback="false" />
    <EfRail id="rail" active="profile" />
  </children>
</component>
