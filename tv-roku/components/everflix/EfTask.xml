<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix: one background worker for every network call the Everflix screens make. -->
<component name="EfTask" extends="Task">
  <interface>
    <field id="job" type="string" />
    <field id="args" type="assocarray" />
    <field id="result" type="assocarray" alwaysNotify="true" />
  </interface>
</component>
