<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix: YouTube sin anuncios, con pestañas como YouTube (Inicio, Suscripciones, Historial, Ver más tarde, Buscar). -->
<component name="EfYouTube" extends="JFScreen">
  <children>
    <Rectangle width="1920" height="1080" color="0x0B0D12FF" />
    <Group id="tabs" translation="[170, 50]" />
    <Label id="heading" translation="[170, 140]" width="1600" color="0xF4F2EEFF" />
    <Group id="searchBox" translation="[170, 210]" visible="false">
      <Poster uri="pkg:/images/everflix/round8.9.png" blendColor="0x161A22FF" width="470" height="70" />
      <Label id="query" translation="[24, 0]" width="430" height="70" vertAlign="center" color="0xF4F2EEFF" />
      <Group id="keys" translation="[0, 100]" />
    </Group>
    <Label id="hint" translation="[170, 220]" width="1600" wrap="true" color="0x9AA0ADFF" text="Cargando…" />
    <MarkupGrid
      id="grid"
      translation="[170, 210]"
      itemComponentName="EfYtCard"
      numColumns="4"
      numRows="3"
      itemSize="[370, 320]"
      itemSpacing="[32, 20]"
      vertFocusAnimationStyle="fixedFocusWrap"
      drawFocusFeedback="false"
      visible="false" />
    <Group id="toast" translation="[170, 990]" visible="false">
      <Poster id="toastBg" uri="pkg:/images/everflix/pill.9.png" blendColor="0x3D63E0FF" height="60" />
      <Label id="toastText" translation="[28, 0]" height="60" vertAlign="center" color="0xFFFFFFFF" />
    </Group>
    <EfRail id="rail" active="youtube" />
    <Timer id="debounce" duration="0.9" repeat="false" />
    <Timer id="toastTimer" duration="5" repeat="false" />
  </children>
</component>
