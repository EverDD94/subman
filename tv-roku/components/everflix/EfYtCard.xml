<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix: miniatura de YouTube para la cuadrícula (duración encima, canal debajo). -->
<component name="EfYtCard" extends="Group">
  <children>
    <Poster id="bg" width="370" height="208" uri="pkg:/images/everflix/round8.9.png" blendColor="0x161A22FF" />
    <MaskGroup id="mask" maskUri="pkg:/images/everflix/mask-wide.png" maskSize="[370, 208]">
      <Poster id="image" width="370" height="208" loadDisplayMode="scaleToZoom" loadWidth="480" loadHeight="270" />
    </MaskGroup>
    <Poster id="durBg" uri="pkg:/images/everflix/round8.9.png" blendColor="0x000000CC" height="34" translation="[0, 164]" />
    <Label id="dur" height="34" translation="[0, 164]" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
    <Poster id="ring" uri="pkg:/images/everflix/focus-ring.9.png" width="370" height="208" visible="false" />
    <Label id="title" translation="[2, 218]" width="366" height="62" wrap="true" maxLines="2" color="0xF4F2EEFF" />
    <Label id="subtitle" translation="[2, 282]" width="366" height="28" color="0x9AA0ADFF" />
  </children>
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <field id="itemHasFocus" type="boolean" onChange="onFocus" />
  </interface>
</component>
