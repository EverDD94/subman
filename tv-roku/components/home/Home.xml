<?xml version="1.0" encoding="utf-8"?>
<!-- Everflix home ("Para ti"): the focused title big over its backdrop, rows below, side menu on the left. -->
<component name="Home" extends="JFScreen">
  <children>
    <Rectangle id="bgColor" width="1920" height="1080" color="0x0B0D12FF" />
    <Poster id="backdropA" width="1920" height="1080" loadDisplayMode="scaleToZoom" loadWidth="1920" loadHeight="1080" opacity="0" />
    <Poster id="backdropB" width="1920" height="1080" loadDisplayMode="scaleToZoom" loadWidth="1920" loadHeight="1080" opacity="0" />
    <Poster uri="pkg:/images/everflix/shade-left.png" width="1300" height="1080" />
    <Poster uri="pkg:/images/everflix/shade-bottom.png" width="1920" height="700" translation="[0, 380]" />

    <EfHero id="hero" translation="[170, 90]" visible="false" />

    <RowList
      id="rows"
      translation="[170, 560]"
      itemComponentName="EfCard"
      itemSize="[1750, 360]"
      numRows="2"
      rowItemSize="[[400, 225]]"
      rowItemSpacing="[[28, 0]]"
      itemSpacing="[0, 10]"
      showRowLabel="[true]"
      rowLabelOffset="[[0, 24]]"
      rowLabelColor="0xF4F2EEFF"
      rowFocusAnimationStyle="floatingFocus"
      vertFocusAnimationStyle="fixedFocus"
      drawFocusFeedback="false" />

    <Label id="empty" translation="[170, 640]" width="1500" color="0x9AA0ADFF" text="Cargando…" />

    <EfRail id="rail" active="home" />
    <Group id="toast" translation="[700, 990]" visible="false">
      <Poster id="toastBg" uri="pkg:/images/everflix/pill.9.png" blendColor="0x3D63E0FF" height="60" />
      <Label id="toastText" translation="[28, 0]" height="60" vertAlign="center" color="0xFFFFFFFF" />
    </Group>
    <Timer id="toastTimer" duration="4" repeat="false" />
    <OptionsSlider id="options" visible="false" />

    <Timer id="heroTimer" duration="0.3" repeat="false" />
    <Animation id="fade" duration="0.5" repeat="false" easeFunction="linear">
      <FloatFieldInterpolator id="fadeIn" key="[0.0, 1.0]" keyValue="[0.0, 1.0]" fieldToInterp="backdropA.opacity" />
      <FloatFieldInterpolator id="fadeOut" key="[0.0, 1.0]" keyValue="[1.0, 0.0]" fieldToInterp="backdropB.opacity" />
    </Animation>
  </children>
  <interface>
    <field id="playlistData" type="array" />
    <field id="selectedItem" type="node" alwaysNotify="true" />
    <field id="quickPlayNode" type="node" alwaysNotify="true" />
    <function name="refresh" />
    <function name="loadLibraries" />
  </interface>
</component>
