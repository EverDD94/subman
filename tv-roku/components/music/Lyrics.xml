<?xml version="1.0" encoding="utf-8"?>
<component name="Lyrics" extends="Group">
    <children>
        <Text id="previousLine" translation="[0, 0]" numLines="2" wrap="true" horizAlign="left" vertAlign="top" opacity=".25"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="36" /></Text>
        <Text id="currentLine" translation="[0, 100]" numLines="2" wrap="true" horizAlign="left" vertAlign="top" opacity="1.0"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="36" /></Text>
        <Text id="nextLine1" translation="[0, 200]" numLines="2" wrap="true" horizAlign="left" vertAlign="top" opacity=".5"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="36" /></Text>
        <Text id="nextLine2" translation="[0, 300]" numLines="2" wrap="true" horizAlign="left" vertAlign="top" opacity=".5"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="36" /></Text>
        <Text id="nextLine3" translation="[0, 400]" numLines="2" wrap="true" horizAlign="left" vertAlign="top" opacity=".25"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="36" /></Text>
    </children>
    <interface>
        <function name="findPosition" />
        <field id="lyricData" type="assocarray" onChange="onLyricDataChange" />
        <field id="positionTime" type="float" onChange="onPositionTimeChange" />
        <field id="width" type="integer" onChange="onWidthChange" />
    </interface>
</component>