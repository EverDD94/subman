<?xml version="1.0" encoding="utf-8"?>
<component name="TVEpisodeListItem" extends="Group">
  <children>
    <LayoutGroup id="toplevel" layoutDirection="vert" itemSpacings="[40]" translation="[0,0]">
      <LayoutGroup id="main_group" layoutDirection="horiz" itemSpacings="[20]">

        <Poster id="poster" width="233" height="200" loadDisplayMode="scaleToZoom">
          <PlayedCheckmark id="playedIndicator" translation="[173, 0]" />
          <Rectangle id="progressBackground" visible="false" color="0x00000098" width="233" height="16" translation="[0,186]">
            <Rectangle id="progressBar" color="#3D63E0FF" width="0" height="16" visible="false" />
          </Rectangle>
        </Poster>

        <LayoutGroup id="text" layoutDirection="vert" itemSpacings="[10]">
          <Poster id="null" height="1" />
          <ScrollingText id="title" maxWidth="540"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="36" /></ScrollingText>

          <LayoutGroup id="infoBar" layoutDirection="horiz" itemSpacings="[15]">
            <Text id="runtime"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="27" /></Text>

            <LayoutGroup id="rating" layoutDirection="horiz" itemSpacings="[-5]">
              <Poster id="star" uri="pkg:/images/sharp_star_white_18dp.png" height="20" width="20" />
              <Text id="communityRating"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="27" /></Text>
            </LayoutGroup>

            <Text id="endtime"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="27" /></Text>
            <Text id="aired"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="27" /></Text>
          </LayoutGroup>

          <Text
            id="overview"
           
            wrap="true"
            height="130"
            width="540"
            maxLines="3"
            lineSpacing="15"
            ellipsizeOnBoundary="true"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="27" /></Text>
        </LayoutGroup>
      </LayoutGroup>
    </LayoutGroup>
  </children>
  <interface>
    <field id="width" type="float" onChange="onWidthChanged" />
    <field id="itemContent" type="node" onChange="itemContentChanged" />
    <field id="itemHasFocus" type="boolean" onChange="focusChanged" />
  </interface>
</component>