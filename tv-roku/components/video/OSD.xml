    <Text id="videoRemainingTime" color="0xCFCAC2FF" horizAlign="left" width="160" translation="[1690,862]"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="30" /></Text>
    <Text id="videoEndingTime" color="0xCFCAC2FF" horizAlign="right" width="360" translation="[1460,948]"><Font role="font" uri="pkg:/fonts/archivo_regular.ttf" size="26" /></Text>

    <Timer id="inactivityTimer" duration="1" repeat="true" />
  </children>
  <interface>
    <function name="updateProgressBar" />
    <function name="checkDisplaySiblingItem" />
    <function name="clampSeek" />
    <function name="setOsdStatus" />
    <function name="focusRightmostVideoControl" />
    <field id="itemBackEnabled" type="boolean" value="false" onChange="onTransportButtonStatusChanged" />
    <field id="chapterBackEnabled" type="boolean" value="false" onChange="onTransportButtonStatusChanged" />
    <field id="chapterNextEnabled" type="boolean" value="false" onChange="onTransportButtonStatusChanged" />
    <field id="itemNextEnabled" type="boolean" value="false" onChange="onTransportButtonStatusChanged" />
    <field id="itemTitleText" type="string" />
    <field id="itemSubtitleText" type="string" />
    <field id="seasonNumber" type="integer" />
    <field id="episodeNumber" type="integer" />
    <field id="episodeNumberEnd" type="integer" />
    <field id="logoImage" type="string" />
    <field id="previousItemIcon" type="string" />
    <field id="previousItemTitleText" type="string" />
    <field id="nextItemIcon" type="string" />
    <field id="nextItemTitleText" type="string" />
    <field id="playbackSpeed" type="float" />
    <field id="progressPercentage" type="float" />
    <field id="positionTime" type="float" />
    <field id="previewPos" type="float" />
    <field id="videoEndingTime" type="string" />
    <field id="remainingPositionTime" type="float" />
    <field id="live" type="boolean" />
    <field id="isRecording" type="boolean" />
    <field id="recordingOffset" type="integer" />
    <field id="recordingStartTime" type="longinteger" />
    <field id="progressDuration" type="integer" />
    <field id="liveTvStartTime" type="longinteger" />
    <field id="liveTvStartOffset" type="integer" />
    <field id="liveTvRewindLimit" type="integer" />
    <field id="defaultButtonIndex" type="integer" />
    <field id="isSeeking" type="boolean" />
    <field id="osdSeekKeyValue" type="string" />
    <field id="seekForward" type="boolean" value="true" />
    <field id="seekSpeedLabel" type="string" value="" alwaysNotify="true" onChange="onSeekSpeedLabelChanged" />
    <field id="skipSegmentButtonVisible" type="boolean" />
    <field id="playbackState" type="string" alwaysNotify="true" />
    <field id="action" type="string" alwaysNotify="true" />
    <field id="showChapterList" type="boolean" alwaysNotify="true" />
    <field id="hasFocus" type="boolean" alwaysNotify="true" />
  </interface>
</component>
