    <Poster uri="pkg:/images/everflix/shade-bottom.png" width="1920" height="700" translation="[0,380]" />

    <Clock id="clock" translation="[96, 56]" />

    <ButtonGroup id="optionControls" itemSpacings="[16]" layoutDirection="horiz" horizAlignment="right" translation="[1848,52]">
      <EfPillButton id="showVideoInfoPopup" icon="pkg:/images/icons/ef-details.png" text="Detalles" />
      <EfPillButton id="showVideoOverviewPopup" icon="pkg:/images/icons/ef-info.png" text="Sinopsis" />
      <EfPillButton id="showCastCrewPopup" icon="pkg:/images/icons/ef-cast.png" text="Reparto" />
      <EfPillButton id="chapterList" icon="pkg:/images/icons/ef-chapters.png" text="Capítulos" />
      <EfPillButton id="showSubtitleMenu" icon="pkg:/images/icons/ef-subtitles.png" text="Subtítulos" />
      <EfPillButton id="showAudioMenu" icon="pkg:/images/icons/ef-audio.png" text="Audio" />
    </ButtonGroup>

    <LayoutGroup id="videoInfo" layoutDirection="vert" itemSpacings="[6]" translation="[96,640]">
