      <IconButton id="chapterBack" padding="40" icon="pkg:/images/icons/ef-back.png" height="76" width="76" />
      <IconButton id="videoPlayPause" padding="38" icon="pkg:/images/icons/play.png" height="76" width="76" />
      <IconButton id="chapterNext" padding="40" icon="pkg:/images/icons/ef-fwd.png" height="76" width="76" />
      <IconButton id="itemNext" padding="40" icon="pkg:/images/icons/ef-next.png" height="76" width="76" />
    </ButtonGroup>

    <ExpandingLabel
      translation="[705, 740]"
      id="previousItem"
      visible="false"
      icon=""
      iconHeight="32"
      iconWidth="32"
      iconAlign="left"
      text=""
      backgroundColor="0x00000095"
      maxWidth="500"
      horizAlign="left"
      horizOffset="64"
      alignmentSide="right"
      fontSize="27"
      padding="[20, 10]"
    />

    <ExpandingLabel
      translation="[1150, 740]"
      id="nextItem"
      visible="false"
      icon=""
      iconHeight="32"
      iconWidth="32"
      iconAlign="left"
      text=""
      backgroundColor="0x00000095"
      maxWidth="500"
      horizAlign="left"
      fontSize="27"
      padding="[20, 10]"
    />

    <Group id="progressBarGroup" translation="[250,878]">
      <Rectangle id="progressBarBackground" width="1420" height="8" />
      <Rectangle id="progressBar" width="0" height="8" />
      <Poster id="scrubber" uri="pkg:/images/icons/progress-bar-scrubber.png" width="24" height="24" />
      <Poster id="scrubberOldPosition" uri="pkg:/images/icons/progress-bar-scrubber.png" width="20" height="20" />
    </Group>

    <Group id="speedBadge" visible="false">
      <Poster id="speedBadgeBg" uri="pkg:/images/everflix/pill.9.png" height="44" blendColor="0xF4F2EEFF" />
      <Poster id="speedBadgeIcon" width="26" height="18" translation="[16,13]" blendColor="0x0B0D12FF" />
      <Label id="speedBadgeText" color="0x0B0D12FF" height="44" vertAlign="center" translation="[48,0]"><Font role="font" uri="pkg:/fonts/archivo_extrabold.ttf" size="26" /></Label>
