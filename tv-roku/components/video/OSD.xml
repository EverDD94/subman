        <Text id="itemSeason" color="0xC9D5FFFF"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="26" /></Text>
        <Text id="itemEpisode" color="0xC9D5FFFF"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="26" /></Text>
        <Text id="itemEpisodeEnd" color="0xC9D5FFFF"><Font role="font" uri="pkg:/fonts/archivo_semibold.ttf" size="26" /></Text>
      </LayoutGroup>
      <ScrollingText id="itemTitle" maxWidth="1300"><Font role="font" uri="pkg:/fonts/archivo_extrabold.ttf" size="58" /></ScrollingText>
    </LayoutGroup>

    <Poster id="osdPanel" uri="pkg:/images/everflix/panel.9.png" width="1800" height="206" translation="[60,822]" />

    <ButtonGroup id="videoControls" itemSpacings="[22]" layoutDirection="horiz" horizAlignment="center" translation="[960,926]">
